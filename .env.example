# Backend runtime (Render / local Go API)
APP_ENV=staging
PORT=8080
BASE_URL=https://almaleek-api-staging.onrender.com
CLIENT_BASE_URL=https://circle.almaleekgh.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/almaleek
CLOUDINARY_CLOUD_NAME=almaleek
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=hello@almaleekgh.com

# Frontend runtime (Vercel / Next.js)
# Keep these browser-safe values public and use Vercel project environment variables.
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_API_BASE_URL=https://almaleek-api-staging.onrender.com
NEXT_PUBLIC_SITE_URL=https://staging.almaleek.com

# Safe local usage:
# - copy backend/.env.example to backend/.env for local Go development
# - set Vercel project environment variables for the frontend, never commit secrets into source control
